{
  "name": "real-estate-opportunity-map",
  "version": "0.1.0",
  "private": true,
  "description": "Choropleth map of Sydney and Brisbane suburbs coloured by real recent price trends — green = falling (opportunity), red = flat/rising.",
  "scripts": {
    "start": "node server.js",
    "fetch:sydney": "bash scripts/fetch-nsw-sales.sh",
    "build:sydney": "node scripts/build-market-sydney.js",
    "fetch:brisbane": "node scripts/fetch-brisbane-data.js",
    "build:brisbane": "node scripts/build-market-brisbane.js",
    "fetch:amenities": "node scripts/fetch-amenities.js",
    "build:amenities": "node scripts/build-amenities.js",
    "fetch:rents-sydney": "bash scripts/fetch-nsw-rents.sh",
    "fetch:rents-brisbane": "node scripts/fetch-rents-brisbane.js",
    "build:rents": "node scripts/build-rents.js",
    "build:sydney-boundaries": "node scripts/build-suburbs.js"
  }
}
